# Copy to .env and fill in. Used by docker-compose.

# Required: free key from https://console.groq.com/keys
GROQ_API_KEY=

# Required: database password. Postgres only reads it when the data volume is first created.
POSTGRES_PASSWORD=

# Required: secret the backend sends to the AI service in X-Internal-Secret.
# Generate one with: openssl rand -hex 32
AI_SHARED_SECRET=

# Optional: when set, the backend requires this value in the X-Api-Key header.
# Put the same value in mobile/.env as EXPO_PUBLIC_API_KEY. It deters abuse; it is not real auth.
API_KEY=

# Optional: free key from https://fdc.nal.usda.gov/api-key-signup (defaults to the rate-limited DEMO_KEY)
USDA_API_KEY=

# Optional: host port for the backend (defaults to 8080)
BACKEND_PORT=

# Production with HTTPS (docker compose --profile https up -d):
# DOMAIN is the public name pointing at this machine; Certbot gets its certificate automatically,
# and LETSENCRYPT_EMAIL (optional) receives Let's Encrypt's expiry notices.
# BACKEND_BIND=127.0.0.1 hides the plain-HTTP backend. The backend reads each client's address from
# the proxy's X-Forwarded-For and ignores that header from anyone else.
DOMAIN=
LETSENCRYPT_EMAIL=
BACKEND_BIND=
